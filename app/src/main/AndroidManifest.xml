<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tier 1: official APIs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Resolves a spoken name to a phone number/email for SMS and calendar invitations
         (contacts/ContactResolver.kt). Read-only, official ContactsContract API. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Requested lazily on first "send a text" confirmation (see NuaScreen.kt's
         SmsConfirmationDialog), not upfront — most users never send SMS via NUA.
         SEND_SMS is one of Google Play's restricted permissions: distributing a build
         that isn't the device's default SMS/Assistant handler requires a Play Console
         permissions declaration, same caveat already noted below for background
         location — not yet filed, since this is still pre-release scaffolding. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Coarse is enough for a city-level weather lookup; no fine location needed. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Geofencing (geofencing/GeofenceManager.kt) needs fine location, and background
         location on API 29+ for transitions to fire while NUA isn't in the foreground.
         Neither is requested unless the user actually adds a location reminder in
         Settings. Google Play requires a background-location declaration form before
         a build using this permission can be published — not yet filed, since this is
         still pre-release scaffolding. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Lets Settings screen ask the user to exempt NUA from battery optimization, needed
         for the wake-word foreground service to survive OEM background-kill policies. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Needed to enumerate launchable apps for AppLauncher (Tier 1: android.intent.action.MAIN
         / CATEGORY_LAUNCHER queries, not automation). See AppLauncher.kt for the query itself. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".NuaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nua">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nua">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wake-word listening. Tier 1: foreground service with a persistent
             notification, no accessibility/automation involved. -->
        <service
            android:name=".services.NuaForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Tier 1: NotificationListenerService is an official Android API. -->
        <service
            android:name=".notifications.NuaNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Tier 2: opt-in, off by default. The user must explicitly enable this in
             Android Settings > Accessibility; NUA never prompts for it implicitly. -->
        <service
            android:name=".automation.NuaAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Home-screen widget: next calendar event, weather, notification summary. -->
        <receiver
            android:name=".widget.NuaWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nua_widget_info" />
        </receiver>

        <!-- Android Auto entry point (Tier 1: Car App Library). "IOT" is the closest
             official category to a general voice assistant; Google Play requires
             category-specific review before a build using this can be published. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".car.NuaCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Geofence ENTER transitions (Tier 1: Play Services Geofencing API). -->
        <receiver
            android:name=".geofencing.NuaGeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Vision input: hands a cache-dir photo URI to the system camera app and
             back (see ui/NuaScreen.kt, vision/ImageEncoder.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable WorkManager's default on-demand initializer: it runs via a
             ContentProvider before Hilt has field-injected NuaApplication.workerFactory.
             WorkManager.initialize() is called manually in NuaApplication.onCreate()
             instead, once that injection has actually happened. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup.InitializationProvider"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
