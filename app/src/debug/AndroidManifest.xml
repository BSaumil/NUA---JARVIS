<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Personal-test debug manifest.

      This variant deliberately removes permissions/components that commonly trigger
      Google Play Protect / Restricted Settings when an APK is sideloaded outside Google
      Play. The production/main manifest is unchanged, so this is NOT a reduction of the
      product's intended capability set.

      Safe debug keeps the core assistant available for first-device validation:
      internet/API access, typed chat, local memory, documents/vision, microphone/manual
      voice, notifications posted by NUA, foreground microphone service and biometrics.

      Advanced/high-risk integrations are intentionally unavailable in this APK and must
      be tested later through a properly signed/internal-distribution build.
    -->

    <uses-permission android:name="android.permission.READ_CALENDAR" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />

    <application>
        <!-- Special-access services are excluded from the sideload-safe debug APK. -->
        <service
            android:name=".notifications.NuaNotificationListenerService"
            tools:node="remove" />
        <service
            android:name=".automation.NuaAccessibilityService"
            tools:node="remove" />

        <!-- No background geofence processing without location permissions. -->
        <receiver
            android:name=".geofencing.NuaGeofenceBroadcastReceiver"
            tools:node="remove" />
    </application>

</manifest>
