# Copy to keystore.properties (already gitignored) and fill in real values for a local
# signed release build. CI supplies the same four values from repository secrets instead
# -- see .github/workflows/android-build.yml's "Decode release keystore" step.
storeFile=/absolute/path/to/nua-release.keystore
storePassword=REPLACE_ME
keyAlias=nua-release
keyPassword=REPLACE_ME
