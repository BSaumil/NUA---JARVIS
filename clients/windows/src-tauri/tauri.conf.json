{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NUA Sovereign",
  "version": "0.1.0",
  "identifier": "com.nua.sovereign.windows",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NUA Sovereign",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
