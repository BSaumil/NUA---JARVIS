<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Standalone for now so it's installable/testable on its own; once this is a
             true companion to the phone app (matching signing + Play listing), this
             should become false so it installs alongside the phone app instead. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Tier 1: the official Wear Tiles API. Shows a status line on the watch
             face's tile carousel, now reading the phone app's presence via the real
             Wearable Data Layer API (docs/PRESENCE_MESH_RFC.md); unverified against a
             real paired device or emulator, neither of which exists in this
             development environment — see README's Known gaps. -->
        <service
            android:name=".NuaTileService"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

    </application>

</manifest>
